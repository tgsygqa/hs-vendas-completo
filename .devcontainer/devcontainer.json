{
  "name": "Hardware Store - Clientes",
  "image": "mcr.microsoft.com/devcontainers/java:1-17-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/java:1": { "version": "none", "installMaven": true },
    "ghcr.io/devcontainers/features/node:2.1.1": { "version": "20" }
  },
  "remoteUser": "root",
  "forwardPorts": [5600, 8080, 5432],
  "portsAttributes": {
    "5600": { "label": "Frontend (V08.html)", "onAutoForward": "notify" },
    "8080": { "label": "Backend (Spring Boot)", "onAutoForward": "notify", "visibility": "public" },
    "5432": { "label": "PostgreSQL", "onAutoForward": "silent" }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/post-start.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "vmware.vscode-boot-dev-pack",
        "editorconfig.editorconfig"
      ]
    }
  }
}
